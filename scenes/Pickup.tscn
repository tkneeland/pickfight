[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/Pickup.gd" id="1"]

; Nothing visual or physical is authored here: Pickup.gd builds the backing
; disc, the weapon's art and the trigger circle from the weapon the pickup
; holds, which it is only given at runtime. A polygon or a shape written down
; here would be overwritten before it was ever drawn, and could drift from the
; weapon it is meant to be showing.
[node name="Pickup" type="Area2D"]
script = ExtResource("1")

[node name="Backing" type="Polygon2D" parent="."]

[node name="Art" type="Polygon2D" parent="."]

[node name="Shape" type="CollisionShape2D" parent="."]
