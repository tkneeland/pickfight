[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/KillZone.gd" id="1"]

[sub_resource type="RectangleShape2D" id="RectangleShape2D_hazard"]
size = Vector2(160, 48)

; Issue #18, "Hazard zone": placed inside the playable area rather than
; beneath it, but otherwise KillZone.gd unmodified -- see that script's
; docstring for why the two turned out identical. A hostile red-orange reads
; as dangerous at a glance (US-5), against the grey-blue Color(0.35, 0.35,
; 0.4, 1) every other stage part draws its terrain in, so a hazard can never
; be mistaken for ordinary ground.
;
; Fixed size rather than an exported one: a stage author who needs a
; different footprint places another instance, and nothing here needed a
; script of its own to make that decision -- CLAUDE.md's class_name rule
; means any script added just to expose one export has to be preloaded by
; path anyway, which is no lighter than authoring a second scene.

[node name="Hazard" type="Area2D"]
script = ExtResource("1")

[node name="HazardShape" type="CollisionShape2D" parent="."]
shape = SubResource("RectangleShape2D_hazard")

[node name="HazardVisual" type="Polygon2D" parent="."]
color = Color(0.85, 0.15, 0.05, 1)
polygon = PackedVector2Array(-80, -24, 80, -24, 80, 24, -80, 24)
