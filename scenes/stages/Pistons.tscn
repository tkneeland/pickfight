[node name="PistonMidRight" parent="." instance=ExtResource("2")]
position = Vector2(330, 470)
size = Vector2(160, 320)
travel = Vector2(0, 100)
one_way_sec = 3

[node name="PistonOuterLeft" parent="." instance=ExtResource("2")]
