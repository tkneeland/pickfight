[ext_resource type="PackedScene" path="res://scenes/parts/KillFloor.tscn" id="killfloor"]

; Four small platforms, all at exactly the same height, with kill space between
; them and underneath. Nothing here is higher than anything else, so the height
; advantage every other stage hands out is simply absent and the fight is about
; spacing alone: which island you are on, and whether you can reach the next
; one before someone swings at you over the gap. The most ring-out-prone stage
; in the rotation, and the shortest rounds.
;
; The third island is a ferry rather than an island (issue #18). This stage
; was already the one about spacing -- which island you are on, and whether
; you can reach the next before someone swings at you over the gap -- so
; making one of the four move is not a new idea bolted on, it is this
; stage's own idea with the answer changing while you decide. It patrols
; horizontally and never leaves y=270 (lifted 30 px by #1202), because the thing worth protecting
; here is that nothing is higher than anything else; a platform that rose
; and fell would quietly hand back the height advantage the stage exists
; to withhold.
;
; The patrol is authored so the ferry docks at each end. At its near end
; its left edge sits 10 px off IslandB's right edge; at its far end its
; right edge meets IslandD's left edge exactly. So it is a crossing that
; opens and closes rather than a moving obstacle: at either end there is a
; step you can take, and in between there is not.

; Backdrop (issue #117): island dusk.
[node name="Islands" type="Node2D"]
script = ExtResource("1")
background_sky_top = Color(0.1, 0.14, 0.24, 1)
background_sky_bottom = Color(0.26, 0.22, 0.28, 1)
background_silhouette = Color(0.1, 0.12, 0.18, 1)
background_layers = PackedStringArray("clouds", "hills")

[node name="IslandA" parent="." instance=ExtResource("platform")]
position = Vector2(-420, 270)
size = Vector2(180, 24)

[node name="IslandB" parent="." instance=ExtResource("platform")]
position = Vector2(-140, 270)
size = Vector2(180, 24)

; Was IslandC, a static platform at x=140. As a ferry it is authored at
; x=50 and travels 190 px right, so its 180 px body spans -40..140 at the
; near end (IslandB ends at -50) and 150..330 at the far end (IslandD begins
; at 330). 2.5 s a leg is slow enough to be a thing you wait for rather than
; a thing you react to.
[node name="Ferry" parent="." instance=ExtResource("3")]
position = Vector2(50, 270)
size = Vector2(180, 24)
travel = Vector2(190, 0)
one_way_sec = 2.5

[node name="IslandD" parent="." instance=ExtResource("platform")]
position = Vector2(420, 270)
size = Vector2(180, 24)

; Outer islets (issue #137, widened to 160 px by #1202): one each side, 80 px off IslandA and
; IslandD -- the same gap as A to B -- so the chain runs x=+-750 and a player
; knocked off an end island has somewhere to land. Same height as the rest.
[node name="IslandE" parent="." instance=ExtResource("platform")]
position = Vector2(-670, 270)
size = Vector2(160, 24)

[node name="IslandF" parent="." instance=ExtResource("platform")]
position = Vector2(670, 270)
size = Vector2(160, 24)

; Reef (#1202): two catch ledges under the chain, top y=420 (inside the 450 bottom of the screen, 162 px under the island tops: the 100-180 px hook range; the islands were lifted 30 px so the reef keeps 138 px of headroom under them, ferry included), spanning x=-780..-100 and 100..780 so the outer islets are caught too. A 200 px drain under the ferry crossing stays open: bots shoved or leaping into a gap died within 4 s, and ring-outs now come through the drain and past x=+-780. Islets widened to 160 px and the end spawns pulled inboard. KillZone stays at y=480.
