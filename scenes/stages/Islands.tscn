[sub_resource type="RectangleShape2D" id="RectangleShape2D_kill"]
size = Vector2(8000, 40)

; Four small platforms, all at exactly the same height, with kill space between
; them and underneath. Nothing here is higher than anything else, so the height
; advantage every other stage hands out is simply absent and the fight is about
; spacing alone: which island you are on, and whether you can reach the next
; one before someone swings at you over the gap. The most ring-out-prone stage
; in the rotation, and the shortest rounds.
;
; The third island is a ferry rather than an island (issue #18). This stage
; was already the one about spacing -- which island you are on, and whether
; you can reach the next before someone swings at you over the gap -- so
; making one of the four move is not a new idea bolted on, it is this
; stage's own idea with the answer changing while you decide. It patrols
; horizontally and never leaves y=300, because the thing worth protecting
; here is that nothing is higher than anything else; a platform that rose
; and fell would quietly hand back the height advantage the stage exists
; to withhold.
;
; The patrol is authored so the ferry docks at each end. At its near end
; its left edge sits 10 px off IslandB's right edge; at its far end its
; right edge meets IslandD's left edge exactly. So it is a crossing that
; opens and closes rather than a moving obstacle: at either end there is a
; step you can take, and in between there is not.

[node name="Islands" type="Node2D"]
script = ExtResource("1")

[node name="IslandA" type="StaticBody2D" parent="."]
position = Vector2(-420, 300)

