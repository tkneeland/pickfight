[sub_resource type="RectangleShape2D" id="RectangleShape2D_kill"]
size = Vector2(8000, 40)

; One long ramp from a low pad on the left to a high landing on the right, with
; open air off both outer edges. It is the only stage in the rotation that is
; not left-right symmetric, so the two slots are not playing the same stage as
; each other: the low player has the whole slope above them to swing up into,
; and the high player has gravity on their side and a shorter fall to survive.
;
; Because the rotation swaps stage every round and spawn order follows slot
; order, the same pair trades ends only when the rotation comes back around --
; which is the point. The asymmetry is meant to be noticed and complained
; about, not balanced away.
;
; The landmass is a single collision polygon rather than a stack of boxes: a
; stepped approximation of a slope catches a swung head on every riser, and
; the whole idea here is one clean surface to slide and swing along.

[node name="Slant" type="Node2D"]
script = ExtResource("1")

