; Dunes (issue #402, a Soccer stage): a wide mound across the middle of the floor, so the ball is played up and
; over it and the two halves are not in each other's line of sight. Symmetric left to right.
; Rotation (Stage.mode_weights): weighted 4x for Soccer, and in any other mode dealt into a bag only 30% of the time.
[node name="Dunes" type="Node2D"]
script = ExtResource("script")
background_sky_top = Color(0.22, 0.15, 0.1, 1)
background_sky_bottom = Color(0.4, 0.28, 0.18, 1)
background_silhouette = Color(0.16, 0.11, 0.08, 1)
background_layers = PackedStringArray("clouds", "hills")
mode_weights = {"soccer": 4.0, "_other": 0.3}

