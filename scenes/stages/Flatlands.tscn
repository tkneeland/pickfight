background_sky_top = Color(0.12, 0.16, 0.26, 1)
background_sky_bottom = Color(0.24, 0.27, 0.3, 1)
background_silhouette = Color(0.12, 0.17, 0.15, 1)
background_layers = PackedStringArray("clouds", "mountains", "hills")

