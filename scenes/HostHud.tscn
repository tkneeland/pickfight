[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/KillFeed.gd" id="1"]

; The host's screen-space HUD (issue #976): the join corner, score line,
; waiting line, round-end scoreboard, QR and kill feed. Main.tscn instances it
; as UI, and the Online joiner (RemoteClient.gd) instances the same scene and
; mirrors the host's state onto it (UiMirror.gd), so both screens draw one HUD.
[node name="UI" type="CanvasLayer"]

[node name="JoinLabel" type="Label" parent="."]
theme_type_variation = &"HudLabel"
offset_left = 12.0
offset_top = 8.0
offset_right = 620.0
offset_bottom = 70.0
text = "Join on your phone: starting server..."

[node name="ScoreLabel" type="Label" parent="."]
theme_type_variation = &"HudLabel"
offset_left = 12.0
offset_top = 8.0
offset_right = 620.0
offset_bottom = 44.0
text = ""

[node name="WaitingLabel" type="Label" parent="."]
theme_type_variation = &"HudHeadingLabel"
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_font_sizes/font_size = 32
horizontal_alignment = 1
vertical_alignment = 1
text = "Waiting for players..."

; Round-end scoreboard: one entry per player slot (Slot0 = Player1 through
; Slot7 = Player8, matching player_paths order below), each an icon tinted
; with that slot's Player.identity_color next to its score number and name.
; Large and centred so the result reads from across the room on the shared
; screen. A grid four wide (issue #138): up to four players is the old single
; row, and five to eight wrap to a second row, since eight entries with
; 12-character names would not fit across the 1600 px screen. Names at 22
; and a 20 px gap (issue #148) so four of the widest 12-character names
; ("WWWWWWWWWWWW") still fit across it.
[node name="Scoreboard" type="GridContainer" parent="."]
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/h_separation = 20
theme_override_constants/v_separation = 24
columns = 4
visible = false

[node name="Slot0" type="HBoxContainer" parent="Scoreboard"]
theme_override_constants/separation = 16

[node name="Icon" type="ColorRect" parent="Scoreboard/Slot0"]
custom_minimum_size = Vector2(56, 56)
color = Color(1, 1, 1, 1)

[node name="Score" type="Label" parent="Scoreboard/Slot0"]
theme_type_variation = &"HudHeadingLabel"
theme_override_font_sizes/font_size = 48
text = "0"

[node name="Name" type="Label" parent="Scoreboard/Slot0"]
theme_type_variation = &"HudLabel"
theme_override_font_sizes/font_size = 20
text = ""

[node name="Slot1" type="HBoxContainer" parent="Scoreboard"]
theme_override_constants/separation = 16

[node name="Icon" type="ColorRect" parent="Scoreboard/Slot1"]
custom_minimum_size = Vector2(56, 56)
