; Kill feed (issue #148): KOs ticker down the top right, under JoinQrCode, and
; a centre banner for big moments. Full-screen and click-through; it builds
; its own children. RoundManager tells it what to show (kill_feed_path).
[node name="KillFeed" type="Control" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
script = ExtResource("1")
