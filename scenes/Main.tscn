; Round-end scoreboard: one entry per player slot (Slot0 = Player1 through
; Slot3 = Player4, matching player_paths order below), each an icon tinted
; with that slot's Player.identity_color next to its score number. Large and
; centred so the result reads from across the room on the shared screen; a
; row of four is under 600 px wide, well inside the 1600 px screen.
[node name="Scoreboard" type="HBoxContainer" parent="UI"]
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 64
alignment = 1
visible = false

