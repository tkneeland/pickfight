[node name="Main" type="Node2D"]

[node name="Camera2D" type="Camera2D" parent="."]
current = true

; Empty container: RoundManager instances the active rotating stage here
; (ADR-0008) rather than a single scene being instanced statically.
[node name="Arena" type="Node2D" parent="."]

; identity_color is paired with SLOT_COLORS in controller/index.html: slot 0
; must match Player1 (blue) and slot 1 must match Player2 (orange). The phone
; tints its "P1"/"P2" badge from that list, which is how a player finds the
; outline, weapon and scoreboard icon that are theirs on the shared screen
; (ADR-0005) -- the
; body fill itself is no longer identity, since it reddens with damage -- so
; the two lists have to stay in sync.
; start_in_round = false: these two are owned by RoundManager now, which
; brings each into play with start_round() once the roster below it is
; ready, rather than either building a live rig at boot with nobody bound.
[node name="Player1" parent="." instance=ExtResource("2")]
position = Vector2(-100, 0)
debug_source = 0
identity_color = Color(0.15, 0.4, 1, 1)
start_in_round = false

[node name="Player2" parent="." instance=ExtResource("2")]
position = Vector2(100, 0)
debug_source = 0
identity_color = Color(1, 0.55, 0.1, 1)
start_in_round = false

; Hitmarkers and debug damage numbers (issue #33), drawn in world space
; where each strike landed. Listens to every player's strike_landed.
[node name="HitFeedback" type="Node2D" parent="."]
script = ExtResource("16")

