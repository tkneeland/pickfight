[node name="ControllerServer" type="Node" parent="."]
script = ExtResource("3")
player_paths = [NodePath("../Player1"), NodePath("../Player2")]
join_label_path = NodePath("../UI/JoinLabel")
qr_texture_path = NodePath("../UI/JoinQrCode")

; Rotation order: Flatlands, Pillars, Ferry, Highrise, Erosion, Islands,
; Furnace, Gauntlet, Cascade, Slant, Bowl. The four stages built on the #18
; parts are interleaved rather than appended, so a stage whose floor moves or
; falls out never immediately follows another one -- a run of them back to
; back would read as the whole game having changed rather than as one stage
; having a gimmick. tools/scenario_runner.gd's STAGE_PATHS lists the same
; eleven in this same order, and the two are meant to stay that way.
[node name="RoundManager" type="Node" parent="."]
script = ExtResource("4")
player_paths = [NodePath("../Player1"), NodePath("../Player2")]
stage_scenes = [ExtResource("5"), ExtResource("8"), ExtResource("12"), ExtResource("6"), ExtResource("13"), ExtResource("9"), ExtResource("14"), ExtResource("7"), ExtResource("15"), ExtResource("10"), ExtResource("11")]
arena_container_path = NodePath("../Arena")
controller_server_path = NodePath("../ControllerServer")
score_label_path = NodePath("../UI/ScoreLabel")
waiting_label_path = NodePath("../UI/WaitingLabel")
scoreboard_path = NodePath("../UI/Scoreboard")
