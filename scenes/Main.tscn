; Empty container: RoundManager instances the active rotating stage here
; (ADR-0008) rather than a single scene being instanced statically.
[node name="Arena" type="Node2D" parent="."]

; identity_color is paired with SLOT_COLORS in controller/index.html: slot 0
; must match Player1 to Player8, in order, and both must match
; Palette.PLAYERS in scripts/Palette.gd (#255). The phone tints its
; "P1"-"P8" badge from that
; list, which is how a player finds the
; outline, weapon and scoreboard icon that are theirs on the shared screen
; (ADR-0005) -- the
; body fill itself is no longer identity, since it reddens with damage -- so
; the two lists have to stay in sync.
; start_in_round = false: all eight are owned by RoundManager now, which
; brings each into play with start_round() once the roster below it is
; ready, rather than any building a live rig at boot with nobody bound.
[node name="Player1" parent="." instance=ExtResource("2")]
position = Vector2(-100, 0)
debug_source = 0
identity_color = Color(0.901961, 0.623529, 0, 1)
start_in_round = false

[node name="Player2" parent="." instance=ExtResource("2")]
position = Vector2(100, 0)
debug_source = 0
identity_color = Color(0.239216, 0.560784, 0.819608, 1)
start_in_round = false

; Players 3 and 4 (issue #36; ADR-0007's four-player roster). Green and
; magenta picked to stay apart from blue and orange, and from each other,
; under the common colour-blindnesses, and to read on the grey stages.
[node name="Player3" parent="." instance=ExtResource("2")]
position = Vector2(-300, 0)
debug_source = 0
identity_color = Color(0, 0.619608, 0.45098, 1)
start_in_round = false

[node name="Player4" parent="." instance=ExtResource("2")]
position = Vector2(300, 0)
debug_source = 0
identity_color = Color(0.835294, 0.368627, 0, 1)
start_in_round = false

; Players 5 to 8 (issue #138, the cap raised to eight). Yellow, cyan, violet
; and red: the four hues left between the first four, each a clear step from
; its neighbours in lightness too, so they still read apart on the stages'
; skies and under the common colour-blindnesses alongside the name tags.
[node name="Player5" parent="." instance=ExtResource("2")]
position = Vector2(-500, 0)
debug_source = 0
identity_color = Color(0.8, 0.47451, 0.654902, 1)
start_in_round = false

