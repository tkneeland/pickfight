vertical_alignment = 1
text = "Waiting for players..."

; Round-end scoreboard: one entry per player slot (Slot0 = Player1, Slot1 =
; Player2, matching player_paths order below), each an icon tinted with that
; slot's Player.identity_color next to its score number. Large and centred
; so the result reads from across the room on the shared screen.
[node name="Scoreboard" type="HBoxContainer" parent="UI"]
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 64
alignment = 1
visible = false

[node name="Slot0" type="HBoxContainer" parent="UI/Scoreboard"]
theme_override_constants/separation = 16

[node name="Icon" type="ColorRect" parent="UI/Scoreboard/Slot0"]
custom_minimum_size = Vector2(56, 56)
color = Color(1, 1, 1, 1)

[node name="Score" type="Label" parent="UI/Scoreboard/Slot0"]
theme_override_font_sizes/font_size = 48
text = "0"

[node name="Slot1" type="HBoxContainer" parent="UI/Scoreboard"]
theme_override_constants/separation = 16

[node name="Icon" type="ColorRect" parent="UI/Scoreboard/Slot1"]
custom_minimum_size = Vector2(56, 56)
color = Color(1, 1, 1, 1)

[node name="Score" type="Label" parent="UI/Scoreboard/Slot1"]
theme_override_font_sizes/font_size = 48
text = "0"

[node name="JoinQrCode" type="TextureRect" parent="UI"]
anchor_left = 1.0
anchor_right = 1.0
offset_left = -196.0
