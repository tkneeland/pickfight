; Round-end scoreboard: one entry per player slot (Slot0 = Player1 through
; Slot7 = Player8, matching player_paths order below), each an icon tinted
; with that slot's Player.identity_color next to its score number and name.
; Large and centred so the result reads from across the room on the shared
; screen. A grid four wide (issue #138): up to four players is the old single
; row, and five to eight wrap to a second row, since eight entries with
; 12-character names would not fit across the 1600 px screen. Names at 22
; and a 20 px gap (issue #148) so four of the widest 12-character names
; ("WWWWWWWWWWWW") still fit across it.
[node name="Scoreboard" type="GridContainer" parent="UI"]
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/h_separation = 20
theme_override_constants/v_separation = 24
columns = 4
visible = false

