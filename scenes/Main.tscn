[gd_scene load_steps=5 format=3]

[ext_resource type="PackedScene" path="res://scenes/Arena.tscn" id="1"]
[ext_resource type="PackedScene" path="res://scenes/Player.tscn" id="2"]
[ext_resource type="Script" path="res://scripts/ControllerServer.gd" id="3"]
[ext_resource type="Script" path="res://scripts/RoundManager.gd" id="4"]

[node name="Main" type="Node2D"]

[node name="Camera2D" type="Camera2D" parent="."]
current = true

[node name="Arena" parent="." instance=ExtResource("1")]

; identity_color is paired with SLOT_COLORS in controller/index.html: slot 0
; must match Player1 (blue) and slot 1 must match Player2 (orange). The phone
; tints its "P1"/"P2" badge from that list, which is how a player finds the
; outline, weapon and scoreboard icon that are theirs on the shared screen
; (ADR-0005) -- the
; body fill itself is no longer identity, since it reddens with damage -- so
; the two lists have to stay in sync.
; start_in_round = false: these two are owned by RoundManager now, which
; brings each into play with start_round() once the roster below it is
; ready, rather than either building a live rig at boot with nobody bound.
[node name="Player1" parent="." instance=ExtResource("2")]
position = Vector2(-100, 0)
debug_source = 1
identity_color = Color(0.15, 0.4, 1, 1)
start_in_round = false

[node name="Player2" parent="." instance=ExtResource("2")]
position = Vector2(100, 0)
debug_source = 0
identity_color = Color(1, 0.55, 0.1, 1)
start_in_round = false

[node name="UI" type="CanvasLayer" parent="."]

[node name="JoinLabel" type="Label" parent="UI"]
offset_left = 12.0
offset_top = 8.0
offset_right = 620.0
offset_bottom = 70.0
text = "Join on your phone: starting server..."

[node name="ScoreLabel" type="Label" parent="UI"]
offset_left = 12.0
offset_top = 74.0
offset_right = 620.0
offset_bottom = 110.0
text = "P1: 0  P2: 0"

[node name="WaitingLabel" type="Label" parent="UI"]
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_font_sizes/font_size = 32
horizontal_alignment = 1
vertical_alignment = 1
text = "Waiting for players..."

; Round-end scoreboard: one entry per player slot (Slot0 = Player1, Slot1 =
; Player2, matching player_paths order below), each an icon tinted with that
; slot's Player.identity_color next to its score number. Large and centred
; so the result reads from across the room on the shared screen.
[node name="Scoreboard" type="HBoxContainer" parent="UI"]
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 64
alignment = 1
visible = false

[node name="Slot0" type="HBoxContainer" parent="UI/Scoreboard"]
theme_override_constants/separation = 16

[node name="Icon" type="ColorRect" parent="UI/Scoreboard/Slot0"]
custom_minimum_size = Vector2(56, 56)
color = Color(1, 1, 1, 1)

[node name="Score" type="Label" parent="UI/Scoreboard/Slot0"]
theme_override_font_sizes/font_size = 48
text = "0"

[node name="Slot1" type="HBoxContainer" parent="UI/Scoreboard"]
theme_override_constants/separation = 16

[node name="Icon" type="ColorRect" parent="UI/Scoreboard/Slot1"]
custom_minimum_size = Vector2(56, 56)
color = Color(1, 1, 1, 1)

[node name="Score" type="Label" parent="UI/Scoreboard/Slot1"]
theme_override_font_sizes/font_size = 48
text = "0"

[node name="JoinQrCode" type="TextureRect" parent="UI"]
anchor_left = 1.0
anchor_right = 1.0
offset_left = -196.0
offset_top = 8.0
offset_right = -12.0
offset_bottom = 192.0
texture_filter = 1
expand_mode = 1
stretch_mode = 5
visible = false

[node name="ControllerServer" type="Node" parent="."]
script = ExtResource("3")
player_paths = [NodePath("../Player1"), NodePath("../Player2")]
join_label_path = NodePath("../UI/JoinLabel")
qr_texture_path = NodePath("../UI/JoinQrCode")

[node name="RoundManager" type="Node" parent="."]
script = ExtResource("4")
player_paths = [NodePath("../Player1"), NodePath("../Player2")]
spawn_points = [Vector2(-100, 0), Vector2(100, 0)]
controller_server_path = NodePath("../ControllerServer")
score_label_path = NodePath("../UI/ScoreLabel")
waiting_label_path = NodePath("../UI/WaitingLabel")
scoreboard_path = NodePath("../UI/Scoreboard")
