; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Pickfight"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[pickfight]

relay_url="wss://pickfight-relay.fly.dev"

; Steam app ID read by scripts/SteamPlatform.gd. 480 is Spacewar, for dev only:
; shipping builds must change it to the real app ID (docs/steam-readiness.md 1.5).
steam_app_id=480

; Sentry DSN for crash reports (#681, docs/crash-reporting.md). The owner pastes it from a
; free Sentry project. A DSN is not a secret (it only lets events in) but keep it out of
; issues. Empty means crash reporting never starts.
sentry_dsn=""

[autoload]

GameClock="*res://scripts/GameClock.gd"
Sfx="*res://scripts/Sfx.gd"
Music="*res://scripts/Music.gd"
SteamPlatform="*res://scripts/SteamPlatform.gd"
Achievements="*res://scripts/Achievements.gd"
CrashReporting="*res://scripts/CrashReporting.gd"

[debug]

; Required by the Sentry SDK for script stack traces in crash reports (#681).
settings/gdscript/always_track_call_stacks=true

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=2
window/stretch/mode="canvas_items"

[gui]

theme/custom="res://art/ui/pickfight_theme.tres"

[internationalization]

locale/translations=PackedStringArray("res://translations/strings.en.translation", "res://translations/strings.de.translation", "res://translations/strings.fr.translation", "res://translations/strings.es.translation", "res://translations/strings.pt_BR.translation", "res://translations/strings.zh_CN.translation", "res://translations/strings.ja.translation", "res://translations/strings.ko.translation", "res://translations/strings.ru.translation")

[physics]

common/physics_interpolation=true
common/physics_jitter_fix=0.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true

; Sentry SDK auto-init off: scripts/CrashReporting.gd is the only thing that starts it (#681).
[sentry]

schema_version=5
options/auto_init=false
options/debug_printing=false
