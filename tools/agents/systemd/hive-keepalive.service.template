# Linux: keeps the AT session alive. Fill the {{PLACEHOLDERS}}, save as ~/.config/systemd/user/hive-keepalive.service, then
#   systemctl --user daemon-reload && systemctl --user enable --now hive-keepalive.service
#   loginctl enable-linger $USER      # keep it running when you are logged out
# SCRIPT: absolute path to tools/agents/hive-keepalive.sh in your checkout.
[Unit]
Description=Autonomous triage session for {{REPO_PATH}} ({{ACCOUNT}})
After=network-online.target

[Service]
Type=simple
Environment=HIVE_ACCOUNT={{ACCOUNT}}
WorkingDirectory={{REPO_PATH}}
ExecStart=/bin/bash {{SCRIPT}}
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
