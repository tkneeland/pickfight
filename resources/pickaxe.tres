[gd_resource type="Resource" script_class="WeaponStats" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/WeaponStats.gd" id="1"]

; The pickaxe's head is the crescent it is drawn as (docs/art/weapons-whiteboard.jpg,
; top middle), filled with a cluster of circles -- seven of them, biggest at the
; belly and tapering toward the horns (ADR-0010). Head-local space has +X
; pointing outward along the haft from the anchor the haft holds the head by,
; so the crescent bulges away from the player with its horns curving back and
; its concave face meeting the haft tip, as in the drawing. It is 17.6 x 26.1 px
; against a 48 x 48 px player body, which is the drawing's proportion against
; its "Reference Player" box.
;
; The owner called the first crescent too fat. This pass cuts deeper into the
; concave face and shortens the horns (span 1.25pi -> 0.95pi), taking the belly
; from over 12 px thick to 10.0 px and the whole head from 19 x 28 px to
; 17.6 x 26.1 px, while the circles go from five to seven and cover 87.3% of
; the outline. Each radius is set a further 0.05 px below its exact fit, so
; that rounding the outline and the circles independently to two decimals
; cannot push one outside; the worst fit is 0.043 px inside the art.
;
; How thin the arc can get is bounded by physics, not by looks, and the bound
; is tight enough to be worth recording. An earlier cut of this revision
; thinned the belly to 4.7 px and refilled it with eighteen circles of
; 1.0-2.3 px radius. Every circle sat inside the art, but three scenarios went
; red: head_plants_player (the head would not come to rest on a body),
; haft_is_non_colliding (the head sank 5.4 px through the bar its own haft
; passes through) and heads_do_not_tunnel_head (1 charge in 12 drove a head
; clean through another). Circles that small cross a contact inside one
; physics step. Shortening the horns instead of thinning the belly is what
; buys the slimmer look back without going under that floor: the smallest
; circle here is 2.01 px and the largest 4.92 px.
;
; A single ConvexPolygonShape2D head -- one wedge with a real point -- was
; tried here earlier and reverted, because the combat scenarios were tuned
; around one uniform radius and WeaponHead.gd's correction maths assumed it.
; That maths is now written per circle, so a drawn head no longer needs a
; polygon to collide as: the circles follow the art and each one is still the
; round shape the sweep and the pair correction were measured on. Collision
; stays circles only, per ADR-0010.
;
; The circles do not reach into the horn tips: nothing of a useful size fits
; where a crescent tapers to a point. The guarantee is one-directional -- every
; circle here lies inside the art (tools/scenario_runner.gd's
; weapon_head_circles_within_art, which allows 0.5 px of slack -- the staff
; and the axe use a little of it, this head none) -- so a player is never hit by something they
; cannot see, which is the half of it that matters.
;
; The belly reaches 9 px past the anchor, against the 8 px the round nub
; reached, unchanged by this revision. That is deliberate: the plant and clash
; scenarios measure where a head comes to rest against terrain, against a
; player and against another
; head, and a head that reached much further would be a different weapon
; rather than the same one redrawn.

[resource]
script = ExtResource("1")
min_reach = 20.0
max_reach = 140.0
mass = 0.25
drive_speed = 24.0
extend_speed = 700.0
rest_return_speed = 400.0
max_drive_force = 6000.0
damage = 34.0
head_circle_offsets = PackedVector2Array(4.08, 0.13, 2.68, -5.07, 2.68, 4.93, -0.52, -8.47, -0.52, 8.53, -4.32, 9.13, -4.32, -9.07)
head_circle_radii = PackedFloat32Array(4.92, 4.58, 4.57, 3.79, 3.77, 2.04, 2.01)
art_outline = PackedVector2Array(-2.97, -13.07, 0.22, -12.41, 3.14, -10.99, 5.63, -8.9, 7.53, -6.26, 8.71, -3.23, 9.11, 0, 8.71, 3.23, 7.53, 6.26, 5.63, 8.9, 3.14, 10.99, 0.22, 12.41, -2.97, 13.07, -8.52, 8.25, -6.51, 7.84, -4.66, 6.94, -3.09, 5.62, -1.89, 3.95, -1.15, 2.04, -0.89, -0, -1.15, -2.04, -1.89, -3.95, -3.09, -5.62, -4.66, -6.94, -6.51, -7.84, -8.52, -8.25)
