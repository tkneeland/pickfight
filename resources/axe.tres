[gd_resource type="Resource" script_class="WeaponStats" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/WeaponStats.gd" id="1"]

; The axe: a single broad bit on a heavy haft
; (docs/art/weapons-whiteboard.jpg, middle right). It is drawn one-sided, so it
; is authored one-sided (#16): a wide fan broader along the haft than across
; it, the haft meeting it near one corner, a scalloped back edge -- two humps
; with a notch between -- and a smooth convex belly sweeping round the leading
; corner. 31.1 x 22.2 px against a 48 x 48 px player body, the drawing's
; proportion against its "Reference Player" box, at 1.05 of the roster's
; whiteboard-to-pixel scale. Sixteen circles fill it (ADR-0010), two big ones
; through the body of the fan and fourteen small ones feeling into the humps
; and the corners; they cover 95.2% of it, and the worst of them stands +0.00
; px outside the traced outline -- inside it, on the geometry rather than on
; weapon_head_circles_within_art's 0.5 px tolerance.
;
; Head-local space is the pickaxe's: +X outward along the haft, origin at the
; groove anchor. The bit is all on +Y, which with the haft pointing right is
; below it on screen. `flips_with_aim` has Player mirror it to -Y whenever the
; aim crosses the vertical, circles and outline together, so aimed left it is
; still below the haft -- the axe is the same axe on both sides of the stage.
;
; The belly reaches 11.00 px past the anchor -- the most on the roster, and
; exactly what the symmetric crescent it replaces reached, because that is
; the forward extent the plant and clash scenarios are measured against. The
; fan trails 19.69 px back down the haft instead; only the reach forward
; along the haft is budgeted, which is the same trick the sword's blade uses.
; Nothing enforces a bound on the forward number; see staff.tres.
;
; Stats against the pickaxe's M/M/M baseline: the axe is power bought with
; time. Weight heavy -- mass 0.45 against 0.25, force ceiling 9000 against
; 6000 -- so it wins clashes against everything and flings its own body
; hardest off a plant. Damage L, 55 against 34, so a clean full-speed hit is
; the most devastating thing on the roster. The cost is responsiveness: the
; drive is two thirds of the pickaxe's -- 16 rad/s against 24, 470 px/s
; against 700, 240 px/s of return against 400 -- so it is the slowest weapon
; on the roster to answer a thumb, and the slowest to reach full extension.
; Reach stays M at 140 px, so weight and damage are the only things traded.

[resource]
script = ExtResource("1")
min_reach = 20.0
max_reach = 140.0
mass = 0.45
drive_speed = 16.0
extend_speed = 470.0
rest_return_speed = 240.0
max_drive_force = 9000.0
damage = 55.0
head_circle_offsets = PackedVector2Array(1.09, 4.91, -8.91, 5.71, -6.11, -2.09, -17.31, 5.91, -10.31, 13.91, -16.91, 3.51, 1.29, 14.91, -16.71, 8.51, 3.29, 14.71, -12.71, 13.11, -3.91, -3.69, 4.89, 14.11, -15.91, 10.11, -0.71, 14.71, -8.71, -2.69, -14.51, 11.91)
head_circle_radii = PackedFloat32Array(9.91, 8.25, 2.56, 2.38, 2.27, 2.02, 1.96, 1.7, 1.6, 1.51, 1.4, 1.32, 1.32, 1.2, 1.14, 1.12)
art_outline = PackedVector2Array(-18.55, 2.1, -18.72, 2.6, -19.01, 3.29, -19.34, 4.1, -19.6, 5, -19.71, 5.92, -19.6, 6.83, -19.21, 7.75, -18.63, 8.75, -17.89, 9.78, -17.07, 10.79, -16.22, 11.75, -15.4, 12.6, -14.58, 13.41, -13.73, 14.23, -12.84, 15, -11.94, 15.63, -11.03, 16.08, -10.15, 16.28, -9.27, 16.07, -8.4, 15.48, -7.52, 14.7, -6.65, 13.92, -5.77, 13.33, -4.9, 13.12, -4.02, 13.4, -3.15, 14.04, -2.27, 14.86, -1.4, 15.71, -0.52, 16.41, 0.35, 16.8, 1.24, 16.88, 2.14, 16.78, 3.04, 16.54, 3.93, 16.18, 4.79, 15.73, 5.6, 15.23, 6.41, 14.57, 7.24, 13.71, 8.03, 12.76, 8.75, 11.84, 9.36, 11.05, 9.8, 10.5, 10.03, 9.76, 10.39, 8.73, 10.79, 7.51, 11.14, 6.2, 11.37, 4.89, 11.38, 3.68, 11.18, 2.48, 10.85, 1.23, 10.39, -0.03, 9.8, -1.22, 9.08, -2.29, 8.23, -3.15, 7.19, -3.81, 5.97, -4.32, 4.62, -4.69, 3.19, -4.96, 1.75, -5.14, 0.35, -5.25, -1.03, -5.29, -2.45, -5.25, -3.88, -5.12, -5.31, -4.9, -6.7, -4.59, -8.05, -4.2, -9.38, -3.66, -10.73, -2.96, -12.05, -2.17, -13.3, -1.36, -14.43, -0.61, -15.4, 0, -16.2, 0.5, -16.88, 0.93, -17.43, 1.31, -17.89, 1.63, -18.25, 1.9, -18.55, 2.1)
