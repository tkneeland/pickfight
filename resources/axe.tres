[gd_resource type="Resource" script_class="WeaponStats" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/WeaponStats.gd" id="1"]

; The axe (playtest 2, issue #49): redrawn so it reads as an axe at a glance,
; which the #16 crescent did not. Side-on, the haft runs through the eye at
; the anchor; a short poll sits behind it (-y) and the blade drops away on the
; other side (+y) through a narrow neck that flares to a broad, curved cutting
; edge 40 px long, bearded at both corners. About 42 px from poll to edge
; against a 48 px player body. One-sided, so it still flips with aim (#16):
; the blade always leads the swing.
;
; Head-local space is the pickaxe's: +X outward along the haft, origin at the
; groove anchor. The art is drawn to a design (a curve through the edge, the
; neck and beard by hand) and the 16 circles were then packed greedily inside
; it -- largest inscribed circle first -- covering 92.8% of it, every one
; clamped at least 0.05 px inside the outline (ADR-0010). The forward extent,
; 19 px past the anchor at the toe, is about what the #45 head reached (19.9).
;
; Stats against the pickaxe's M/M/M baseline: the axe is power bought with
; time, pushed further after the second playtest. Damage 90 -- the per-strike
; cap (Player.MAX_STRIKE_DAMAGE) -- so two clean hits always kill and one
; never does (owner's decision). And it is deliberately sluggish: mass 0.7
; against 0.25 and a force ceiling of 9000 against 6000, so it wins every
; clash, but a drive of 9 rad/s against 24, 300 px/s out against 700 and
; 150 px/s back against 400 -- by far the slowest weapon on the roster to
; answer a thumb. Reach M at 140 px.

[resource]
script = ExtResource("1")
min_reach = 20.0
max_reach = 140.0
mass = 0.7
drive_speed = 9.0
extend_speed = 300.0
rest_return_speed = 150.0
max_drive_force = 9000.0
damage = 90.0
head_circle_offsets = PackedVector2Array(-1, 21.5, 0, 9.5, 0, -2, -12.5, 25, 10.5, 25, -4.5, 3.5, 4.5, 3.5, 15.5, 25.5, -9.5, 30, -5, -7, 5, -7, 8, 29.5, 11, 20, -18, 26.5, -13, 19.5, 7, 12.5)
head_circle_radii = PackedFloat32Array(11.89, 7.1, 6.95, 5.32, 4.93, 2.45, 2.45, 2.11, 2.01, 1.95, 1.95, 1.88, 1.86, 1.77, 1.42, 1.37)
art_outline = PackedVector2Array(-7, -9, 7, -9, 7, 8, 9, 14, 13, 19.5, 19, 26, 15.67, 27.9, 12.33, 29.67, 9, 31.2, 5.67, 32.4, 2.33, 33.18, -1, 33.5, -4.33, 33.34, -7.67, 32.73, -11, 31.7, -14.33, 30.33, -17.67, 28.73, -21, 27, -17, 22, -12, 16, -8.5, 11.5, -7, 8)
flips_with_aim = true
