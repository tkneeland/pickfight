[gd_resource type="Resource" script_class="WeaponStats" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/WeaponStats.gd" id="1"]

; The flail (issue #150): a spiked ball on a real chain.
;
; The arm ends in a small knob (`art_outline`, one circle), which is what
; plants and climbs like any head, and hits lightly (damage S, 14). Off the
; knob hangs a chain of five jointed links, 80 px long, and on the end of
; it the ball: a 0.25 weight, 9 px across the middle and drawn with spikes
; as `ball_art`. Nothing drives the chain or the ball (FlailChain.gd). The
; arm swings the knob and the chain drags the ball after it, so the ball
; trails behind a slow swing and whips round on a fast one: hard to aim,
; and its big hits come from momentum.
;
; A ball strike is scored on the ball's own speed, on the same scale as any
; head: 38 at the 2200 px/s of a committed swing, twice that past it, never
; over 90. It also shoves the victim along its path by its momentum
; (speed x 0.25 x 1.2), up to 700. A slow ball does nothing.
;
; Reach S (70) and the sword's drive. Force 7300, under the medium weapons'
; 8000 (#180; 5500 against 6000 before). The ball never owns a clash correction against another head
; (its drive is 0), so the flail blocks poorly.

[resource]
script = ExtResource("1")
min_reach = 20.0
; Playtest 2026-09-27: arm reach 70 -> 85, "a bit longer".
max_reach = 85.0
mass = 0.2
drive_speed = 36.0
extend_speed = 1150.0
rest_return_speed = 800.0
max_drive_force = 7300.0
damage = 14.0
sound_set = &"flail"
special = &"flail"
chain_links = 5
chain_length = 80.0
chain_link_mass = 0.02
ball_mass = 0.25
ball_radius = 9.0
ball_damage = 38.0
ball_knockback = 1.2
ball_art = PackedVector2Array(9.6, 0, 12.47, 5.17, 6.79, 6.79, 5.17, 12.47, 0, 9.6, -5.17, 12.47, -6.79, 6.79, -12.47, 5.17, -9.6, 0, -12.47, -5.17, -6.79, -6.79, -5.17, -12.47, 0, -9.6, 5.17, -12.47, 6.79, -6.79, 12.47, -5.17)
pickup_art = PackedVector2Array(40.79, -6.79, 46.47, -5.17, 43.6, 0, 46.47, 5.17, 40.79, 6.79, 39.17, 12.47, 34, 9.6, 28.83, 12.47, 27.21, 6.79, 21.53, 5.17, 23.68, 1.3, 6.01, 1.3, 6.01, 2.49, 2.49, 6.01, -2.49, 6.01, -6.01, 2.49, -6.01, -2.49, -2.49, -6.01, 2.49, -6.01, 6.01, -2.49, 6.01, -1.3, 23.68, -1.3, 21.53, -5.17, 27.21, -6.79, 28.83, -12.47, 34, -9.6, 39.17, -12.47)
