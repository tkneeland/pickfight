[gd_resource type="Resource" script_class="WeaponStats" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/WeaponStats.gd" id="1"]

; The dagger: a short leaf blade on a stub grip
; (docs/art/weapons-whiteboard.jpg, bottom right). The head is the blade,
; per issue #13's roster -- 12.4 x 4.1 px against a 48 x 48 px player body,
; the drawing's proportion against its "Reference Player" box -- filled by
; five circles tapering to the point (ADR-0010). They cover 80.0% of it,
; each sized with a small clearance margin below its exact fit so that
; independent rounding of the outline and the circles to two decimals
; cannot push one outside: a blade this small is mostly edge, and an edge
; is where a circle fits worst. What that costs is the part of the art
; nothing collides with, never the other way round -- every circle is
; inside the drawing. The owner asked for it slightly longer, so the blade
; is a fifth longer than before (15 px -> 18 px before scale) at the same
; width, with its tip taper blunted a touch to buy back the coverage the
; clearance margin costs.
;
; Head-local space is the pickaxe's: +X outward along the haft, origin at the
; groove anchor. Like the sword the blade lies across that anchor rather than
; out in front of it, from -5.4 px behind to 7.0 px past, with the circles
; stopping at 6 px forward, unchanged from before the lengthening -- the
; second shortest forward extent on the roster. That spread is a convention
; the roster was drawn to rather than a checked bound; see staff.tres.
;
; Stats against the pickaxe's M/M/M baseline (retuned after the first
; playtest, #45): the dagger is the close-range brawler, and the owner asked
; for it significantly faster. Weight light -- mass 0.15 against 0.25 -- but a
; force ceiling of 7300 against 8000 (#180): fast, yet it wins a clash of heads
; only against the staff's 6700. Force also caps how hard the drive can pull,
; and at 7300 the dagger answers a drag in 3-4 ticks. Its drive is the quickest on
; the roster (65 rad/s, 3400 px/s out, 1200 px/s back). Reach S, 80 px against
; 150, keeps it a brawler and makes climbing hard with it. Damage 45 against
; 34: a weapon you have to be next to someone to use should hurt when it
; lands. The blade was stretched 1.5x along its length only, circles
; refitted at the same spacing and width, every one still inside the art.
; Playtest 2026-09-27: damage 60 -> 70, asked for alongside the sword's bump.
;
; Issue #136, more responsive: drive 50 -> 65 rad/s, extension 2600 -> 3400
; px/s out and 900 -> 1200 px/s back, force ceiling 5000 -> 5500. The ceiling
; stays under the medium weapons' 6000: at 6000-7500 the dagger stopped losing
; to the axe head-on (heavy_weapon_wins_clash). Issue #180 let a stalled axe
; push its full 11000 rather than about 6000, which is what made 7300 safe.

[resource]
script = ExtResource("1")
min_reach = 20.0
max_reach = 88.0
mass = 0.15
drive_speed = 65.0
extend_speed = 3400.0
rest_return_speed = 1200.0
max_drive_force = 7300.0
damage = 70.0
sound_set = &"dagger"
head_circle_offsets = PackedVector2Array(-4.9, -0.08, -2.77, -0.08, -0.64, -0.08, 1.48, -0.08, 3.61, -0.08, 5.74, -0.08, 7.87, -0.08)
head_circle_radii = PackedFloat32Array(2.21, 2.1, 2.01, 1.92, 1.84, 1.75, 1.66)
art_outline = PackedVector2Array(-9.38, -1.31, -5.53, -2.38, 9.89, -1.71, 12.04, 0.0, 9.89, 1.71, -5.53, 2.38, -9.38, 1.31)
