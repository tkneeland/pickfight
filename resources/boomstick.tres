[gd_resource type="Resource" script_class="WeaponStats" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/WeaponStats.gd" id="1"]

; The boomstick: a sawn-off gun on a stick, the owner's idea from playtest 2
; (issue #55). It is the roster's only weapon that shoots as well as swings
; (ADR-0014), so the head is the whole gun: a flared stock behind the anchor,
; a short receiver, a straight barrel and a thicker muzzle ring at the end,
; drawn symmetric about the haft so it needs no flipping (only the axe flips,
; #16). 96 x 12 px against a 48 x 48 px player body, filled by twenty-seven
; circles: three stepping down through the stock and receiver, twenty-two
; 2.8 px circles 3.1 px apart down the 6.4 px barrel, and two on the 9 px
; muzzle ring (ADR-0010). Every circle clears the outline by at least 0.2 px,
; so no rounding pushes one outside, and none is under the ~2 px floor the
; head-tunnelling scenarios are measured against (see pickaxe.tres). The
; barrel's smallest circle is bigger than the sword's tip circle.
;
; Head-local space is the pickaxe's: +X outward along the haft, origin at the
; groove anchor. Laid out like the sword: the stock sits 24 px behind the
; anchor and the muzzle 72 px past it. With the sword's 70 px reach, haft and
; gun together are the sword's length, 142 px from body to muzzle. Bullets
; leave from the anchor along the haft (Player._fire), so they come out
; through the barrel as drawn.
;
; Handling is the sword's, per the owner (#55): reach S 70 px, drive 36
; rad/s, 1350 px/s out, 900 px/s back (since #136), and its 6000 force ceiling, so it wins
; and loses clashes like the sword and pickaxe. Mass is much lower, 0.1
; against the sword's 0.25: a light weapon on a stick. Melee damage is
; pitiful on purpose, 8 against the pickaxe's 34, the lowest on the roster.
; The gun is the damage.
;
; Firing (owner's numbers): a shot every 3 s (#92; 5 s in #55), automatic,
; straight down the barrel. The bullet flies straight at 900 px/s with no
; gravity, a 6 px circle (#92; 5 px in #61, 3 px in #55), so players can see
; it coming. It deals a flat 35 and hits once: it vanishes on the first player
; or terrain it meets, and flies through weapon heads (#92, reversing #61).
; It shoves the player it hits with an impulse of 260. Each shot kicks the
; shooter back along the barrel with an impulse of 190 (#92; 150 before),
; still inside `boomstick_recoil_is_moderate`. Enough to stop anyone camping, rarely
; fatal on its own. Knockback and recoil are agent defaults for the owner to
; tune in playtest.
;
; Issue #136 raised the handling with the sword's: drive 24 -> 36 rad/s,
; extension 900 -> 1350 px/s out and 600 -> 900 px/s back.

[resource]
script = ExtResource("1")
min_reach = 20.0
max_reach = 70.0
mass = 0.1
drive_speed = 36.0
extend_speed = 1350.0
rest_return_speed = 900.0
max_drive_force = 6000.0
damage = 8.0
sound_set = &"boomstick"
fire_interval = 3.0
projectile_damage = 35.0
projectile_speed = 900.0
projectile_knockback = 260.0
projectile_radius = 6.0
recoil_impulse = 190.0
head_circle_offsets = PackedVector2Array(-19.3, 0, -13.5, 0, -8.6, 0, -4.4, 0, -1.3, 0, 1.8, 0, 4.9, 0, 8, 0, 11.1, 0, 14.2, 0, 17.3, 0, 20.4, 0, 23.5, 0, 26.6, 0, 29.7, 0, 32.8, 0, 35.9, 0, 39, 0, 42.1, 0, 45.2, 0, 48.3, 0, 51.4, 0, 54.5, 0, 57.6, 0, 60.7, 0, 65.8, 0, 67.9, 0)
head_circle_radii = PackedFloat32Array(4.4, 4.3, 3.7, 2.8, 2.8, 2.8, 2.8, 2.8, 2.8, 2.8, 2.8, 2.8, 2.8, 2.8, 2.8, 2.8, 2.8, 2.8, 2.8, 2.8, 2.8, 2.8, 2.8, 2.8, 2.8, 3.9, 3.9)
art_outline = PackedVector2Array(-24, -6, -8, -4.5, -4, -3.2, 62, -3.2, 62, -4.5, 72, -4.5, 72, 4.5, 62, 4.5, 62, 3.2, -4, 3.2, -8, 4.5, -24, 6)
