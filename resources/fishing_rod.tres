[gd_resource type="Resource" script_class="WeaponStats" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/WeaponStats.gd" id="1"]

; The fishing rod (issue #273): a light launcher that fires a hook on a line.
; Lighter and faster than the grapple, with shorter range and less power.
; A versatile traversal and combat tool for hooking players or terrain.
;
; Flick the drag to fire: the hook flies straight out along the flick at
; 1800 px/s for up to 400 px. If it meets terrain it sticks there, and while
; the drag is held the rope reels in at 750 px/s, hauling the player toward
; the hook with at most 3500 force, down to 60 px. Release to let go; the hook
; reels home and can fire again 0.25 s after it arrives. A hook that meets
; a player takes 4 off them and tugs them 250 toward the thrower, then comes
; home. The launcher itself swings as a light melee weapon: reach S, damage S (8),
; with a light drive suited to quick flicks.
;
; The head is the launcher grip, a thin shape drawn as `art_outline` and filled
; by two circles. The hook sitting in it is `loaded_art`: drawn over the head
; while the hook is home, hidden while it is out, and colliding with nothing.
;
; Force ceiling 6500, lighter than the grapple to reflect quick responsiveness.

[resource]
script = ExtResource("1")
min_reach = 20.0
max_reach = 80.0
mass = 0.15
drive_speed = 42.0
extend_speed = 1200.0
rest_return_speed = 850.0
max_drive_force = 6500.0
damage = 8.0
sound_set = &"grapple"
special = &"grapple"
loaded_art = PackedVector2Array(6, -0.8, 12, -0.8, 10, -4, 18, 0, 10, 4, 12, 0.8, 6, 0.8)
launch_range = 400.0
launch_cooldown = 0.25
reel_speed = 750.0
reel_force = 3500.0
reel_min_length = 60.0
projectile_speed = 1800.0
projectile_damage = 4.0
projectile_knockback = 250.0
projectile_radius = 4.0
pickup_art = PackedVector2Array(18, 0, 10, 4, 12, 0.8, 7, 0.8, 7, 2, 5, 3.5, -5, 3.5, -5, -3.5, 5, -3.5, 7, -2, 7, -0.8, 12, -0.8, 10, -4)
head_circle_offsets = PackedVector2Array(-2, 0, 2, 0)
head_circle_radii = PackedFloat32Array(2.5, 2.5)
art_outline = PackedVector2Array(-5, -3, 5, -3, 7, -2, 7, 2, 5, 3.5, -5, 3.5)
