[gd_resource type="Resource" script_class="WeaponStats" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/WeaponStats.gd" id="1"]

; The shield (issue #275). A broad plate on a short haft. It does little damage
; by itself, but Player.gd (under `special = &"shield"`) makes a hit that lands
; on the side the shield faces mostly bounce off, and a bash with it shoves
; whoever it hits hard. Blocking and bashing are the whole weapon.
;
; The head is a tall column of circles so the face is wide enough to cover the
; holder. Head-local space as every other weapon's, +X along the haft.

[resource]
script = ExtResource("1")
min_reach = 20.0
max_reach = 90.0
mass = 0.3
drive_speed = 36.0
extend_speed = 900.0
rest_return_speed = 600.0
max_drive_force = 7000.0
damage = 10.0
sound_set = &"shield"
special = &"shield"
head_circle_offsets = PackedVector2Array(3, -14, 3, -7, 3, 0, 3, 7, 3, 14)
head_circle_radii = PackedFloat32Array(4, 4, 4, 4, 4)
art_outline = PackedVector2Array(-1, -18, 9, -18, 9, 18, -1, 18)
