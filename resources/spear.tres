[gd_resource type="Resource" script_class="WeaponStats" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/WeaponStats.gd" id="1"]

; The spear (issue #272, owner's idea from content grill #263): a very long
; reach and a hard hit at the point, paid for by being terrible up close.
; `min_reach` is the closest the head can come to the body -- the groove the
; head rides in starts there (Player._rebuild_weapon) and the commanded reach
; is clamped to it -- so a spear cannot be pulled in tight: 90 px against the
; 20 px every other weapon rests at. Anyone inside that distance is past the
; point and out of reach of the head altogether.
;
; Against the staff, the other long weapon (240 px, damage 20): the spear
; reaches further (320 px) and hits nearly four times as hard (75), but it is
; heavier (0.2 against 0.15), slower to swing and cannot be held close.
; Force ceiling 7000, under the medium weapons' 8000 and over the staff's 6700.
;
; Head-local space as every other weapon's: +X along the haft, origin at the
; groove anchor. The head is the leaf-shaped point only, two circles about 10
; px along the haft.

[resource]
script = ExtResource("1")
min_reach = 90.0
max_reach = 320.0
mass = 0.2
drive_speed = 36.0
extend_speed = 1800.0
rest_return_speed = 900.0
max_drive_force = 7000.0
damage = 75.0
sound_set = &"spear"
head_circle_offsets = PackedVector2Array(3, 0, 8, 0)
head_circle_radii = PackedFloat32Array(2.5, 2)
art_outline = PackedVector2Array(-2, 2.6, 4, 3, 8, 2.6, 12, 0, 8, -2.6, 4, -3, -2, -2.6)
