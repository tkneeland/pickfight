[gd_resource type="Resource" script_class="WeaponStats" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/WeaponStats.gd" id="1"]

; Redrawn in #621 (docs/design/weapon-heads/) as a spiked mace knob on a short socket;
; its one circle now sits on the knob.
;
; The staff: a long pole with a small knob at the tip
; (docs/art/weapons-whiteboard.jpg, top left). Only the knob is the head --
; issue #13's roster calls it "tip knob only" -- so what is drawn here is one
; round 6.2 x 6.2 px knob and nothing else, against a 48 x 48 px player body,
; which is the drawing's proportion against its "Reference Player" box. One
; circle fills 90.6% of it; a knob is the one head shape a single circle is
; already the right answer for.
;
; Head-local space is the same as the pickaxe's: +X points outward along the
; haft away from the player, origin at the groove anchor the haft holds the
; head by. The knob sits just past that anchor and reaches 5 px along the
; haft, the shortest forward extent on the roster. Nothing enforces a bound
; on that number -- the plant and clash scenarios measure where a head comes
; to rest, they do not check its extent -- so the roster's 5-11 px spread is
; a convention the weapons were drawn to, not a checked constraint.
;
; Stats against the pickaxe's M/M/M baseline (retuned after the first
; playtest, #45): the staff is the roster's best mover and its worst hitter.
; Reach L (240 px against 150) makes it the weapon that gets to a ledge first,
; and the one that can hang from Gauntlet's ceiling. Weight light -- mass 0.15
; against 0.25, force ceiling 6700 against 8000 (#180) -- so it loses clashes to
; everything, the dagger included, and its drive is quick (50 rad/s, 2100 px/s
; out, 1000 px/s back) so it answers a thumb immediately. Damage S (20 against
; 34) is the price, and it is paid twice: the tiny head is also the hardest
; on the roster to actually land.
;
; Issue #136, more responsive: drive 36 -> 50 rad/s, extension 1500 -> 2100
; px/s out and 700 -> 1000 px/s back, force ceiling 4000 -> 5000 so it hauls
; the body around harder. Still under the dagger's 5500, so it still loses
; every clash. Issue #180: 5000 -> 6700, scaled with the medium weapons'
; 6000 -> 8000 and still under the dagger's 7300.

[resource]
script = ExtResource("1")
min_reach = 20.0
max_reach = 240.0
mass = 0.15
drive_speed = 50.0
extend_speed = 2100.0
rest_return_speed = 1000.0
max_drive_force = 6700.0
damage = 20.0
sound_set = &"staff"
head_circle_offsets = PackedVector2Array(7.4, 0)
head_circle_radii = PackedFloat32Array(4)
art_outline = PackedVector2Array(-2, -1.3, 2.2, -1.3, 1.6, -5.4, 2.8, -7, 3.9, -4.3, 5.8, -4.5, 7.2, -4.6, 8.6, -4.3, 9.8, -3.6, 10.8, -2.6, 11.4, -1.4, 11.6, 0, 11.4, 1.4, 10.8, 2.6, 9.8, 3.6, 8.6, 4.3, 7.2, 4.6, 5.8, 4.5, 3.9, 4.3, 2.8, 7, 1.6, 5.4, 2.2, 1.3, -2, 1.3)
