[gd_resource type="Resource" script_class="WeaponStats" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/WeaponStats.gd" id="1"]

; The sword: a long tapering blade on a short grip
; (docs/art/weapons-whiteboard.jpg, bottom left). The head is the whole blade
; and not the hilt, per issue #13's roster, so the outline traced here is the
; blade alone -- 38.6 x 6.9 px against a 48 x 48 px player body, the drawing's
; proportion against its "Reference Player" box -- filled by ten circles,
; biggest at the shoulder and tapering to the point (ADR-0010). They cover
; 83.9% of it, each sized with a small clearance margin below its exact fit
; so that independent rounding of the outline and the circles to two
; decimals cannot push one outside. The owner asked for a decent bit more
; blade at the same width, so the blade is a third longer than the first
; pass (40 px -> 56 px before scale) with its 5 px half-width unchanged.
;
; Head-local space is the pickaxe's: +X outward along the haft, origin at the
; groove anchor. The blade lies mostly **behind** that anchor, from -24.3 px
; back along the haft to +14.3 px past it, with the circles stopping at 9 px
; forward, same as before the lengthening. That is what lets a longer blade
; keep the proportion it is drawn at and still reach no further past the
; anchor than the pickaxe's crescent does: the plant and clash scenarios
; measure along the haft, and anything across it or behind it costs them
; nothing. It is also why the blade reads as a big close-in hitting and
; blocking area rather than as extra reach -- exactly the trade issue #13
; asks of it.
;
; Stats against the pickaxe's M/M/M baseline (retuned after the first
; playtest, #45): the sword is the pickaxe with its reach traded for blade.
; Weight M is the baseline (mass 0.25, force 8000 since #180, drive 36 rad/s since #136). Reach S,
; 70 px against 150, is balanced by a blade 2.5x as long as it first was --
; the blocking area and the reach are the trade. A quicker extension than the
; pickaxe (1150 px/s out, 800 px/s back, against 700 / 600 since #136) and damage a
; little over the baseline (40 against 34) keep a short lever worth swinging.
; The blade was stretched 2.5x along its length only, forward: its back end
; stays 24 px behind the anchor, because stretched about the anchor it
; would have reached 61 px back down a 70 px haft and into the wielder's own
; body. So the tip now reaches about 72 px past the anchor, 142 px from the
; body. Circles refitted at the same spacing and width, every one still
; clamped inside the art.
;
; Issue #136, more responsive: drive 24 -> 36 rad/s, extension 900 -> 1150
; px/s out and 600 -> 800 px/s back. The force ceiling stayed at 6000 (8000
; since #180). 1350 px/s
; out (the boomstick's) with the 36 rad/s drive put the long blade through
; another head in one charge of roster_heads_do_not_tunnel_head_reversed
; (135 degrees at 1800 px/s each); either change alone did not.

[resource]
script = ExtResource("1")
min_reach = 20.0
max_reach = 70.0
mass = 0.25
drive_speed = 36.0
extend_speed = 1150.0
rest_return_speed = 800.0
max_drive_force = 8000.0
damage = 40.0
sound_set = &"sword"
head_circle_offsets = PackedVector2Array(-14.33, -0.05, -11.22, -0.05, -8.1, -0.05, -4.99, -0.05, -1.88, -0.05, 1.24, -0.05, 4.35, -0.05, 7.47, -0.05, 10.58, -0.05, 13.69, -0.05, 16.81, -0.05, 19.92, -0.05, 23.03, -0.05, 26.15, -0.05, 29.26, -0.05, 32.37, -0.05, 35.49, -0.05, 38.6, -0.05, 41.72, -0.05, 44.83, -0.05, 47.94, -0.05, 51.06, -0.05, 54.17, -0.05)
head_circle_radii = PackedFloat32Array(2.62, 2.87, 3.14, 3.31, 3.26, 3.21, 3.16, 3.1, 3.05, 3, 2.95, 2.89, 2.84, 2.79, 2.74, 2.69, 2.63, 2.58, 2.53, 2.48, 2.41, 2.17, 1.93)
art_outline = PackedVector2Array(-24.33, -1.9, -6.95, -3.45, 51.02, -2.48, 72.27, 0, 51.02, 2.48, -6.95, 3.45, -24.33, 1.9)
