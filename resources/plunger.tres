[gd_resource type="Resource" script_class="WeaponStats" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/WeaponStats.gd" id="1"]

; The plunger (issue #270): a rubber cup that sticks to what it meets.
;
; Plunge an opponent and the head stays on them, so swinging the arm drags them
; around; plunge terrain and the head holds, the holder hangs from it like a
; rope pendulum. It never reels the holder in -- that is the grapple's job -- and
; a hard pull (the head torn off its anchor, or the holder hauled well past the
; arm's length) pops it free, as does letting go of the drag. All of it is
; Player.gd's `special = &"plunger"`. The hit itself is light.

[resource]
script = ExtResource("1")
min_reach = 20.0
max_reach = 84.0
mass = 0.18
drive_speed = 36.0
extend_speed = 1100.0
rest_return_speed = 800.0
max_drive_force = 7000.0
damage = 10.0
sound_set = &"plunger"
special = &"plunger"
head_circle_offsets = PackedVector2Array(1, 0, 5, 0)
head_circle_radii = PackedFloat32Array(2.8, 3.2)
art_outline = PackedVector2Array(-2, -3, 4, -3, 9, -7, 9, 7, 4, 3, -2, 3)
