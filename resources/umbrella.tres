[gd_resource type="Resource" script_class="WeaponStats" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/WeaponStats.gd" id="1"]

; The umbrella (issue #269). Closed -- pointed anywhere but up -- it is a short,
; light poker: low damage, reach under the pickaxe's. Held overhead (aim within
; about 45 degrees of straight up) the canopy is open, and Player.canopy_open()
; makes it slow the fall, catch wind zones and turn hits on its face. Those
; effects live in Player.gd under `special = &"umbrella"`; there is no gust push.
;
; The canopy was enlarged 1.35x in #1276 (art outline and hit circles together, so the drawn
; canopy is what catches hits; glide and wind constants in Player.gd do not depend on size).
; The head (redrawn in #621, docs/design/weapon-heads/) is a ribbed canopy on a thin
; shaft: a big circle for the canopy, two for its shoulders, a small one for the shaft. Head-local space as every other weapon's, +X along the haft.

[resource]
script = ExtResource("1")
min_reach = 20.0
max_reach = 150.0
mass = 0.15
drive_speed = 36.0
extend_speed = 900.0
rest_return_speed = 600.0
max_drive_force = 7000.0
damage = 12.0
sound_set = &"umbrella"
special = &"umbrella"
head_circle_offsets = PackedVector2Array(1.35, 0, 10.8, 0, 9.45, -9.45, 9.45, 9.45)
head_circle_radii = PackedFloat32Array(1.215, 6.075, 3.645, 3.645)
art_outline = PackedVector2Array(-2.7, -1.35, 4.725, -1.35, 2.7, -5.805, 6.21, -11.61, 2.7, -17.55, 6.48, -17.01, 10.125, -15.255, 13.23, -12.42, 15.525, -8.775, 17.01, -4.59, 17.55, -1.62, 22.275, 0, 17.55, 1.62, 17.01, 4.59, 15.525, 8.775, 13.23, 12.42, 10.125, 15.255, 6.48, 17.01, 2.7, 17.55, 6.21, 11.61, 2.7, 5.805, 4.725, 1.35, -2.7, 1.35)
