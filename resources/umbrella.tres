[gd_resource type="Resource" script_class="WeaponStats" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/WeaponStats.gd" id="1"]

; The umbrella (issue #269). Closed -- pointed anywhere but up -- it is a short,
; light poker: low damage, reach under the pickaxe's. Held overhead (aim within
; about 45 degrees of straight up) the canopy is open, and Player.canopy_open()
; makes it slow the fall, catch wind zones and turn hits on its face. Those
; effects live in Player.gd under `special = &"umbrella"`; there is no gust push.
;
; The head (redrawn in #621, docs/design/weapon-heads/) is a ribbed canopy on a thin
; shaft: a big circle for the canopy, two for its shoulders, a small one for the shaft. Head-local space as every other weapon's, +X along the haft.
; #1276: the canopy (its three circles and outline points) is 1.35x the #621 size, scaled
; about the stub junction (2, 0); the handle stub and the shaft circle are unchanged. Glide
; and wind constants in Player.gd do not depend on size; the bigger canopy also blocks and
; grips over a larger area.

[resource]
script = ExtResource("1")
min_reach = 20.0
max_reach = 150.0
mass = 0.15
drive_speed = 36.0
extend_speed = 900.0
rest_return_speed = 600.0
max_drive_force = 7000.0
damage = 12.0
sound_set = &"umbrella"
special = &"umbrella"
head_circle_offsets = PackedVector2Array(1, 0, 10.1, 0, 8.75, -9.45, 8.75, 9.45)
head_circle_radii = PackedFloat32Array(0.9, 6.075, 3.645, 3.645)
art_outline = PackedVector2Array(-2, -1, 3.5, -1, 2, -5.805, 5.51, -11.61, 2, -17.55, 5.78, -17.01, 9.425, -15.255, 12.53, -12.42, 14.825, -8.775, 16.31, -4.59, 16.85, -1.62, 21.575, 0, 16.85, 1.62, 16.31, 4.59, 14.825, 8.775, 12.53, 12.42, 9.425, 15.255, 5.78, 17.01, 2, 17.55, 5.51, 11.61, 2, 5.805, 3.5, 1, -2, 1)
