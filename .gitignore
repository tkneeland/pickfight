# Godot 4+ specific ignores
.godot/
.import/
export.cfg
build/

# Mono-specific ignores
.mono/
data_*/

# System/tool-specific ignores
.DS_Store

# atlas-v3:gitignore:start
.claude/worktrees/
.claude/atlas-state/
# Test evidence stays committable even where a team rule would ignore it.
# Both lines are needed: the first re-includes the directory (git will not
# descend into an ignored one), the second re-includes what is inside it.
# Neither can help if an ANCESTOR directory is ignored; git cannot
# re-include anything under an excluded parent.
!test-results/
!test-results/**
# atlas-v3:gitignore:end

# Steam dev app ID (Spacewar 480); see docs/steam-readiness.md 6.1
steam_appid.txt
# GodotSteam binaries (#428): installed by tools/fetch_godotsteam.sh, never committed
addons/godotsteam/

# Sentry Godot SDK binaries (#681): installed by tools/fetch_sentry.sh, never committed
addons/sentry/

# Movie Maker clips (#743)
*.avi
override.cfg
